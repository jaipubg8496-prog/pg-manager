# Copy this file to .env and fill in real values. Never commit .env to git.

# Get a free Postgres connection string from neon.tech or supabase.com
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-64-character-hex-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Get these from dashboard.razorpay.com (Settings -> API Keys). Test-mode keys
# start with rzp_test_ and work immediately with no business verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — only needed for the "Sign in with Google" button. Get this from
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Leave blank to hide the Google button entirely.
GOOGLE_CLIENT_ID=
